{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Express App",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "App listening at http://localhost:(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
