@startuml

left to right direction
skinparam componentStyle rectangle

actor User

rectangle "Presentation Layer" {

    [React Frontend]

}

rectangle "Application Layer" {

    [FastAPI Backend]

    [Language Detection]

    [Translation Service]

    [Retriever Service]

}

rectangle "Knowledge Layer" {

    database "FAISS Vector DB"

    folder "Knowledge Base"

